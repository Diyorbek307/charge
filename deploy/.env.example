# Copy to deploy/.env and fill in. Never commit the real .env.

# Domain pointed at this server (A record). Caddy issues HTTPS for it.
DOMAIN=ipakvolt.uz

# Long random strings — e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
OCPP_PASSWORD=

# false in production: hides demo logins, demo SMS codes and sandbox top-ups.
DEMO_MODE=false

# Payments (merchant cabinets of Payme and Click).
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# SMS via Eskiz.uz.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Web Push — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@ipakvolt.uz

# Public address of the app, printed into station QR stickers (e.g. https://powergo.uz).
# Empty: the address the network's dashboard is opened on.
VITE_PUBLIC_URL=

# Cookieless analytics (optional; leave empty to disable).
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=

# Navigator voice (optional; without it the phone's own voice speaks).
# Microsoft Azure Speech — neural Russian and Uzbek voices:
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# …or Yandex SpeechKit (service-account API key):
YANDEX_SPEECHKIT_KEY=
YANDEX_FOLDER_ID=
# Force one: azure | yandex | none. Voices per language: TTS_VOICE_RU, TTS_VOICE_UZ, TTS_VOICE_EN.
TTS_PROVIDER=

# PowerGo's own rewards: bonus for the car's details, how long a bonus lives, the monthly cap for all grants.
CAR_BONUS_UZS=100000
BONUS_DAYS=60
REWARDS_MONTH_BUDGET_UZS=50000000

# PowerGo Plus subscription: price for 30 days and the discount PowerGo pays on every charge.
PLUS_PRICE_UZS=49000
PLUS_DISCOUNT_PCT=5
