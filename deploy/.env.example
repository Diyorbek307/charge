# Copy to deploy/.env and fill in. Never commit the real .env.

# Domain pointed at this server (A record). Caddy issues HTTPS for it.
DOMAIN=ipakvolt.uz

# Long random strings — e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
OCPP_PASSWORD=

# false in production: hides demo logins, demo SMS codes and sandbox top-ups.
DEMO_MODE=false

# Payments (merchant cabinets of Payme and Click).
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# SMS via Eskiz.uz.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Web Push — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@voli.uz

# Public address of the app, printed into station QR stickers (e.g. https://voli.uz).
# Empty: the address the network's dashboard is opened on.
VITE_PUBLIC_URL=

# Letters to the team: new applications from the site, support requests, SOS.
# Any SMTP mail host works; for Zoho: smtp.zoho.com (or smtp.zoho.eu), port 465,
# the mailbox address and an app password made in Zoho's security settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=info@voli.uz
MAIL_FROM=

# Error reports to Sentry (optional; empty sends nothing). Both take the DSN
# from the Sentry project: the server's errors and the app's. No names, phone
# numbers, tokens or request bodies are sent.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Landing and app on two sites (optional; empty = one site serves both).
# On the app's server (app.voli.uz):
#   VITE_LANDING_URL=https://voli.uz      its front page sends visitors to the landing
#   CORS_ORIGINS=https://voli.uz,https://www.voli.uz   the landing may call this API
# On the landing's static site (voli.uz):
#   VITE_API_URL=https://app.voli.uz       live figures and applications go to the app's server
#   VITE_APP_URL=https://app.voli.uz       its buttons open the app
VITE_LANDING_URL=
CORS_ORIGINS=
VITE_API_URL=
VITE_APP_URL=

# Cookieless analytics (optional; leave empty to disable).
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=

# Navigator voice (optional; without it the phone's own voice speaks).
# Microsoft Azure Speech — neural Russian and Uzbek voices:
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# …or Yandex SpeechKit (service-account API key):
YANDEX_SPEECHKIT_KEY=
YANDEX_FOLDER_ID=
# Force one: azure | yandex | none. Voices per language: TTS_VOICE_RU, TTS_VOICE_UZ, TTS_VOICE_EN.
TTS_PROVIDER=

# Voli's own rewards: bonus for the car's details, how long a bonus lives, the monthly cap for all grants.
CAR_BONUS_UZS=100000
BONUS_DAYS=60
REWARDS_MONTH_BUDGET_UZS=50000000

# Voli Plus subscription: price for 30 days and the discount Voli pays on every charge.
PLUS_PRICE_UZS=49000
PLUS_DISCOUNT_PCT=5

# Uzum Bank and Humo acquiring (wallet top-ups). Empty: the sandbox.
UZUM_MERCHANT_ID=
UZUM_SECRET=
UZUM_CHECKOUT_URL=
HUMO_MERCHANT_ID=
HUMO_SECRET=
HUMO_CHECKOUT_URL=

# Production: switch the demo off. With DEMO_MODE=false the demo logins,
# the fixed demo SMS code, the payment sandbox and "reset the database" are gone.
# DEMO_MODE=false
# Extra hosts the page may call (your own router or tile server), space-separated.
CSP_EXTRA_CONNECT=
