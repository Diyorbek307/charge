<?xml version="1.0" encoding="utf-8"?>
<!-- The live card: near-black with a warm glow from the corner, like the charging screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#FF111111" /><corners android:radius="18dp" /></shape></item>
    <item><shape><gradient android:type="radial" android:gradientRadius="260dp" android:centerX="1" android:centerY="0" android:startColor="#38FFC83D" android:endColor="#00FFC83D" /><corners android:radius="18dp" /></shape></item>
    <item><shape><stroke android:width="1dp" android:color="#33FFC83D" /><corners android:radius="18dp" /></shape></item>
</layer-list>
