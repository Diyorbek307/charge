<?xml version="1.0" encoding="utf-8"?>
<!-- The live card opened: what is charging, how far, and the numbers -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/charge_card_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/charge_bolt_bg">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/charge_bolt" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/station" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FF9A9A9A" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFC83D" android:textSize="34sp" android:textStyle="bold" android:layout_marginStart="10dp" android:includeFontPadding="false" />
    </LinearLayout>

    <ProgressBar android:id="@+id/bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="12dp"
        android:max="100" android:progressDrawable="@drawable/charge_progress" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/l_energy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF9A9A9A" android:textSize="12sp" />
            <TextView android:id="@+id/v_energy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/l_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF9A9A9A" android:textSize="12sp" />
            <TextView android:id="@+id/v_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/power_box" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/l_power" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF9A9A9A" android:textSize="12sp" />
            <TextView android:id="@+id/v_power" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textColor="#FFFFE7A0" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
