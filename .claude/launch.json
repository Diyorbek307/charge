{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.PORT='3100';process.env.DATA_DIR='.data-preview';import('./server.js')"
      ],
      "port": 3100
    }
  ]
}